---
import Layout from '../layouts/Layout.astro';
import { DEFAULT_LANG, localePath, useTranslations } from '../i18n/ui';

const t = useTranslations(DEFAULT_LANG);
const getPath = (path: string) => localePath(DEFAULT_LANG, path);
---

<Layout title={`404 - ${t('notFound.title')}`}>
  <section class="py-32 text-center">
    <div class="max-w-lg mx-auto px-6">
      <div class="text-8xl font-bold bg-gradient-to-r from-[#007aff] to-[#5ac8fa] bg-clip-text text-transparent mb-6">
        404
      </div>
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">{t('notFound.title')}</h1>
      <p class="text-gray-500 dark:text-gray-400 mb-8">{t('notFound.desc')}</p>
      <a
        href={getPath('/')}
        class="inline-flex items-center gap-2 px-6 py-3 bg-[#007aff] text-white rounded-xl font-medium hover:bg-[#0062cc] transition-colors"
      >
        {t('notFound.home')}
      </a>
    </div>
  </section>
</Layout>
