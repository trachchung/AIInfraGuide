---
import Layout from '../../../layouts/Layout.astro';
import { langParams, langFromParam, localePath } from '../../../i18n/ui';

export const getStaticPaths = () => langParams().map((lang) => ({ params: { lang } }));

const lang = langFromParam(Astro.params.lang);
const getPath = (path: string) => localePath(lang, path);

const STRONG = 'class="font-semibold text-gray-900 dark:text-white"';
const GH = 'href="https://github.com/caomaolufei/AIInfraGuide" target="_blank" rel="noopener noreferrer" class="font-semibold text-[#007aff] dark:text-[#0a84ff] hover:underline"';
const C = {
  zh: {
    pageTitle: '关于 - AIInfraGuide',
    pageDesc: '关于 AIInfraGuide 作者草帽路飞',
    name: '草帽路飞',
    avatarAlt: '草帽路飞头像',
    role: '{C.role}',
    expertise: ['分布式训练', '推理优化', '算子优化', 'CPU+GPU异构优化', 'CUDA', 'HPC'],
    aboutMe: '关于我',
    paragraphs: [
      `你好！我是 <strong ${STRONG}>草帽路飞</strong>，目前在互联网大厂基模团队从事 AI Infra 方向研发工作，拥有多年相关工作经验，主攻<strong ${STRONG}>模型训练、推理和算子优化</strong>方向。`,
      `我也是开源项目 <a ${GH}>AIInfraGuide</a> 的作者——这是一套「从 0 入门 AI Infra 全栈」的学习教程，希望帮助更多人系统性地构建从底层 CUDA 编程到分布式训练、推理优化的完整知识体系。`,
      '我硕士研究方向为传统高性能计算（HPC），主要从事面向 CPU 与 GPU 异构平台的数值模式优化工作，在算子级优化与系统级性能调优方面具备较为扎实的积累。硕士期间拥有 3 段 AI Infra 相关实习，毕业后通过校招加入某大厂从事 AI Infra 研发至今。',
      '做这个项目的初衷，是把工作中零散积累的知识重新梳理成体系，也希望和更多对 AI Infra 感兴趣的朋友一起交流成长。后续我会结合一线工程实践，持续输出学习笔记与系统化教程～',
    ],
    contact: '联系方式',
    wechatLabel: '公众号',
    zhihuLabel: '知乎',
    xhsLabel: '小红书',
    groupAlt: 'AIInfraGuide 微信交流群二维码',
    groupTitle: '加入AIInfraGuide交流群',
    groupDesc: '扫码加入 AIInfraGuide 微信交流群，与更多 AI Infra 同好一起讨论训练、推理与算子优化的实战经验。',
    personalAlt: '草帽路飞个人微信二维码',
    personalTitle: '草帽路飞个人微信',
    personalDesc: '扫码添加我的个人微信，一起交流 AI Infra 学习与实战经验，也欢迎技术合作与探讨。另外需要【求职咨询/学习规划/求职陪跑】等服务的可以加我。',
    roadmap: '教程更新计划',
  },
  en: {
    pageTitle: 'About - AIInfraGuide',
    pageDesc: 'About Caomaolufei, the author of AIInfraGuide',
    name: 'Caomaolufei (草帽路飞)',
    avatarAlt: 'Caomaolufei avatar',
    role: 'AI Infra engineer on a foundation model team at a large internet company · Author of AIInfraGuide',
    expertise: ['Distributed training', 'Inference optimization', 'Kernel optimization', 'CPU+GPU heterogeneous optimization', 'CUDA', 'HPC'],
    aboutMe: 'About me',
    paragraphs: [
      `Hi, I'm <strong ${STRONG}>Caomaolufei</strong>. I work on AI Infra for a foundation model team at a large internet company and have several years of experience in the field, mostly on <strong ${STRONG}>model training, inference and kernel optimization</strong>.`,
      `I also wrote <a ${GH}>AIInfraGuide</a>, an open-source tutorial that starts from zero and covers the whole AI Infra stack. It takes you from low-level CUDA programming through distributed training and inference optimization.`,
      'For my master\'s degree I studied traditional high-performance computing (HPC), mainly optimizing numerical models on heterogeneous CPU and GPU platforms, so I have a solid background in kernel-level optimization and system-level performance tuning. I did three AI Infra internships during the program and joined a large company through campus recruiting after graduating. I have worked on AI Infra there ever since.',
      'I started this project to turn what I had picked up piecemeal at work into something organized, and to meet other people interested in AI Infra. I will keep writing notes and tutorials based on what I run into at work.',
    ],
    contact: 'Contact',
    wechatLabel: 'WeChat account',
    zhihuLabel: 'Zhihu',
    xhsLabel: 'Xiaohongshu',
    groupAlt: 'QR code for the AIInfraGuide WeChat group',
    groupTitle: 'Join the AIInfraGuide group',
    groupDesc: 'Scan to join the AIInfraGuide WeChat group, where people talk about hands-on training, inference and kernel optimization.',
    personalAlt: 'QR code for Caomaolufei\'s personal WeChat',
    personalTitle: 'Caomaolufei on WeChat',
    personalDesc: 'Scan to add me on WeChat if you want to talk about learning or working on AI Infra. I am also open to technical collaboration, and I offer job-search advice, study planning and interview coaching.',
    roadmap: 'Tutorial roadmap',
  },
  vi: {
    pageTitle: 'Giới thiệu - AIInfraGuide',
    pageDesc: 'Giới thiệu về Caomaolufei, tác giả AIInfraGuide',
    name: 'Caomaolufei (草帽路飞)',
    avatarAlt: 'Ảnh đại diện của Caomaolufei',
    role: 'Kỹ sư AI Infra trong nhóm mô hình nền tảng tại một công ty internet lớn · Tác giả AIInfraGuide',
    expertise: ['Huấn luyện phân tán', 'Tối ưu suy luận', 'Tối ưu kernel', 'Tối ưu dị thể CPU+GPU', 'CUDA', 'HPC'],
    aboutMe: 'Về tôi',
    paragraphs: [
      `Chào bạn, tôi là <strong ${STRONG}>Caomaolufei</strong>. Tôi làm AI Infra trong nhóm mô hình nền tảng tại một công ty internet lớn, đã có nhiều năm kinh nghiệm trong lĩnh vực này, chủ yếu về <strong ${STRONG}>huấn luyện mô hình, suy luận và tối ưu kernel</strong>.`,
      `Tôi cũng là tác giả của <a ${GH}>AIInfraGuide</a>, bộ tài liệu mã nguồn mở dạy AI Infra từ con số 0. Tài liệu đi từ lập trình CUDA cấp thấp đến huấn luyện phân tán và tối ưu suy luận.`,
      'Khi học thạc sĩ, tôi nghiên cứu tính toán hiệu năng cao (HPC) truyền thống, chủ yếu tối ưu các mô hình số trên nền tảng dị thể CPU và GPU, nên có nền tảng khá vững về tối ưu ở cấp kernel và tinh chỉnh hiệu năng ở cấp hệ thống. Trong thời gian học tôi đã thực tập AI Infra ở 3 nơi, sau khi tốt nghiệp thì vào một công ty lớn qua đợt tuyển sinh viên và làm AI Infra ở đó đến nay.',
      'Tôi làm dự án này để sắp xếp lại những gì học được rời rạc trong công việc, và để trao đổi với những người cũng quan tâm đến AI Infra. Tôi sẽ tiếp tục viết ghi chép và bài hướng dẫn dựa trên kinh nghiệm thực tế.',
    ],
    contact: 'Liên hệ',
    wechatLabel: 'Tài khoản WeChat',
    zhihuLabel: 'Zhihu',
    xhsLabel: 'Xiaohongshu',
    groupAlt: 'Mã QR nhóm WeChat AIInfraGuide',
    groupTitle: 'Tham gia nhóm AIInfraGuide',
    groupDesc: 'Quét mã để vào nhóm WeChat AIInfraGuide, nơi mọi người trao đổi kinh nghiệm thực tế về huấn luyện, suy luận và tối ưu kernel.',
    personalAlt: 'Mã QR WeChat cá nhân của Caomaolufei',
    personalTitle: 'WeChat cá nhân của Caomaolufei',
    personalDesc: 'Quét mã để kết bạn WeChat với tôi nếu bạn muốn trao đổi về việc học và làm AI Infra. Tôi cũng sẵn sàng hợp tác kỹ thuật, và có nhận tư vấn tìm việc, lập kế hoạch học và kèm luyện phỏng vấn.',
    roadmap: 'Kế hoạch cập nhật',
  },
}[lang];

const contacts = [
  {
    label: C.wechatLabel,
    value: '《AI Infra Guide》',
    href: 'https://mp.weixin.qq.com/s/oxUBDTd-b1aZnh0jGR5tqw',
