    bg: 'bg-emerald-50 dark:bg-emerald-500/10',
    icon: 'M8.505 11.53a.72.72 0 0 1-.727.72.72.72 0 0 1-.728-.72c0-.397.326-.72.728-.72.401 0 .727.323.727.72Zm3.264-.72a.72.72 0 0 0-.728.72c0 .397.326.72.728.72a.72.72 0 0 0 .727-.72.72.72 0 0 0-.727-.72Zm-2.6-4.526C4.735 6.284 1.5 9.09 1.5 12.57c0 1.998 1.078 3.775 2.766 4.938a.55.55 0 0 1 .2.618l-.376 1.402c-.033.124.11.225.217.152l1.826-1.065a.65.65 0 0 1 .543-.072 8.36 8.36 0 0 0 2.293.32c.156 0 .31-.006.463-.016a5.35 5.35 0 0 1-.276-1.703c0-3.098 3.014-5.613 6.732-5.613.154 0 .306.006.457.016-.53-2.673-3.36-4.783-6.876-4.783Z',
